# Docker / database
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=codemem
MYSQL_USER=codemem
MYSQL_PASSWORD=codemem
MYSQL_PORT=3306
REDIS_PORT=6379
POSTGRES_DB=codemem
POSTGRES_USER=codemem
POSTGRES_PASSWORD=codemem
POSTGRES_PORT=5432

# Knowledge base (read-only).
KNOWLEDGE_ROOT=E:/Note/知识库
KNOWLEDGE_CHUNK_MAX_CHARS=1200
KNOWLEDGE_TOP_K=4
EMBEDDING_DIMENSIONS=1024

# AI chat: true = MockChatEngine（不需要 Key，只演示链路）；false = 走真实模型。
CODEMEM_AI_MOCK=true

# ===== 对话模型：DeepSeek（OpenAI 兼容）=====
# 想用 DeepSeek 对话：填 Key，并把 CODEMEM_AI_MOCK 改成 false。
# DeepSeek 控制台：https://platform.deepseek.com/api_keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-flash

# ===== 向量服务（embedding）=====
# DeepSeek 没有 embeddings 接口，不能用 DeepSeek Key 做向量。
# 默认用 hash：零配置可跑通，但语义检索很弱。
EMBEDDING_PROVIDER=hash

# 想用真实向量服务时，把上面改成 openai 并填下面几项（以硅基流动 BAAI/bge-m3 为例，有免费额度）：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# CODEMEM_EMBEDDING_API_KEY=
# OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
#
# 阿里云百炼（DashScope）也可以：
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-v3

# Outbox async extraction.
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_RETRIES=3
OUTBOX_RETRY_BACKOFF_SECONDS=30

# Front-end origin allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000